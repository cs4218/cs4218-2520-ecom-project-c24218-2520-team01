{
    "name": "ecom",
    "version": "1.0.0",
    "description": "ecommerce rest api",
    "main": "server.js",
    "type": "module",
    "scripts": {
        "start": "node server.js",
        "server": "nodemon server.js",
        "client": "npm start --prefix ./client",
        "dev": "concurrently \"npm run server\" \"npm run client\"",
        "sonarqube": "sonar-scanner",
        "test": "node node_modules/jest/bin/jest.js --config jest.config.js",
        "test:frontend": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.frontend.config.js",
        "test:ui": "playwright test tests/e2e",
        "test:ai-ui": "node ai/ui-tests/ai.scenario.js",
        "test:backend": "node node_modules/jest/bin/jest.js --config jest.backend.config.js",
        "test:integration": "node node_modules/jest/bin/jest.js --config jest.integration.config.js"
    },
    "keywords": [],
    "author": "RP",
    "license": "ISC",
    "dependencies": {
        "@browserbasehq/stagehand": "^3.2.0",
        "antd": "^5.15.0",
        "bcrypt": "^5.1.1",
        "braintree": "^3.22.0",
        "colors": "^1.4.0",
        "concurrently": "^8.2.2",
        "cors": "^2.8.5",
        "date-fns": "^3.3.1",
        "dotenv": "^16.6.1",
        "express": "^4.18.2",
        "express-formidable": "^1.2.0",
        "jsonwebtoken": "^9.0.2",
        "mongodb": "^6.3.0",
        "mongodb-memory-server": "^11.0.1",
        "mongoose": "^8.1.2",
        "morgan": "^1.10.0",
        "nodemon": "^3.0.3",
        "openai": "^6.32.0",
        "playwright": "^1.58.2",
        "react-helmet": "^6.1.0",
        "react-hot-toast": "^2.4.1",
        "react-icons": "^5.0.1",
        "react-router-dom": "^6.22.0",
        "slugify": "^1.6.6"
    },
    "devDependencies": {
        "@babel/core": "^7.24.5",
        "@babel/preset-env": "^7.24.5",
        "@babel/preset-react": "^7.24.1",
        "@playwright/test": "^1.44.0",
        "@testing-library/jest-dom": "^5.17.0",
        "@testing-library/react": "^13.4.0",
        "@testing-library/user-event": "^13.5.0",
        "@types/node": "^20.12.12",
        "babel-jest": "^29.7.0",
        "identity-obj-proxy": "^3.0.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "mockingoose": "^2.16.2",
        "sonarqube-scanner": "^4.3.4",
        "mongodb-memory-server": "^11.0.1",
        "supertest": "^7.2.2"
    }
